MIDSCENE_MODEL_BASE_URL=YOUR_MODEL_BASE_URL
MIDSCENE_MODEL_API_KEY=YOUR_MODEL_API_KEY
MIDSCENE_MODEL_NAME=YOUR_MODEL_NAME
MIDSCENE_MODEL_FAMILY=YOUR_MODEL_FAMILY

HEADLESS=false

# Local validation examples: verify these values against your own running devices.
# Start Android first, then use its serial from `adb devices -l`.
ANDROID_DEVICE_ID=emulator-5554
# Start WDA for your iOS simulator/device. 127.0.0.1 refers to this test runner.
WDA_BASE_URL=http://127.0.0.1:8100
# WDA_MJPEG_URL=http://127.0.0.1:9100

# Replace this sample with your computer's LAN address reachable from the phones.
# SHOWCASE_LAN_HOST=192.168.1.10
# SHOWCASE_PORT=4173
