MIDSCENE_MODEL_BASE_URL=YOUR_MODEL_BASE_URL
MIDSCENE_MODEL_API_KEY=YOUR_MODEL_API_KEY
MIDSCENE_MODEL_NAME=YOUR_MODEL_NAME
MIDSCENE_MODEL_FAMILY=YOUR_MODEL_FAMILY

HEADLESS=false

# Sample values only: start and configure your own devices before running.
# Two Android devices, using the serials shown by `adb devices -l`.
ANDROID_DEVICE_IDS=emulator-5554,emulator-5556
# Two different iOS devices, each with its own WDA and MJPEG endpoint.
# Items at the same position must belong to the same device.
# 127.0.0.1 refers to the computer running this example.
WDA_BASE_URLS=http://127.0.0.1:8100,http://127.0.0.1:8101
WDA_MJPEG_URLS=http://127.0.0.1:9100,http://127.0.0.1:9101
